-- Phase 4: B端功能数据库架构

-- 1. 旅行社（Agencies）表
CREATE TABLE IF NOT EXISTS agencies (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name TEXT NOT NULL,
  owner_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
  plan TEXT DEFAULT 'free', -- 'free', 'team', 'enterprise'
  logo_url TEXT,
  description TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. 团队成员（Agency Members）表
CREATE TABLE IF NOT EXISTS agency_members (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agency_id UUID REFERENCES agencies(id) ON DELETE CASCADE,
  user_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
  role TEXT DEFAULT 'member', -- 'owner', 'admin', 'member'
  permissions JSONB DEFAULT '{}', -- {'crm': true, 'orders': false}
  created_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(agency_id, user_id)
);

-- 3. 客户（Customers）表
CREATE TABLE IF NOT EXISTS customers (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agency_id UUID REFERENCES agencies(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  phone TEXT,
  email TEXT,
  wechat TEXT,
  tags TEXT[] DEFAULT '{}', -- ['VIP客户', '回头客']
  notes TEXT,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 4. 客户行程（Customer Trips）表
CREATE TABLE IF NOT EXISTS customer_trips (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  customer_id UUID REFERENCES customers(id) ON DELETE CASCADE,
  destination TEXT NOT NULL,
  start_date DATE,
  end_date DATE,
  status TEXT DEFAULT 'inquiry', -- 'inquiry', 'confirmed', 'completed', 'cancelled'
  budget NUMERIC,
  people_count INTEGER DEFAULT 1,
  notes TEXT,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 5. 订单（Travel Orders）表
CREATE TABLE IF NOT EXISTS travel_orders (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  order_no TEXT UNIQUE NOT NULL,
  agency_id UUID REFERENCES agencies(id) ON DELETE CASCADE,
  customer_id UUID REFERENCES customers(id),
  trip_id UUID REFERENCES customer_trips(id),
  status TEXT DEFAULT 'pending', -- 'pending', 'confirmed', 'paid', 'completed', 'cancelled'
  total_amount NUMERIC DEFAULT 0,
  paid_amount NUMERIC DEFAULT 0,
  payment_method TEXT, -- 'wechat', 'alipay', 'bank', 'cash'
  notes TEXT,
  created_by UUID REFERENCES profiles(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 6. 订单项（Order Items）表
CREATE TABLE IF NOT EXISTS order_items (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  order_id UUID REFERENCES travel_orders(id) ON DELETE CASCADE,
  item_type TEXT NOT NULL, -- 'flight', 'hotel', 'ticket', 'guide', 'transport', 'other'
  item_name TEXT NOT NULL,
  quantity INTEGER DEFAULT 1,
  unit_price NUMERIC DEFAULT 0,
  subtotal NUMERIC DEFAULT 0,
  notes TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 7. 白标配置（Whitelabel Configs）表
CREATE TABLE IF NOT EXISTS whitelabel_configs (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agency_id UUID UNIQUE REFERENCES agencies(id) ON DELETE CASCADE,
  brand_name TEXT,
  logo_url TEXT,
  primary_color TEXT DEFAULT '#1E88E5', -- 主题色
  secondary_color TEXT DEFAULT '#FF9800',
  slogan TEXT,
  custom_domain TEXT,
  favicon_url TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 创建索引提升性能
CREATE INDEX IF NOT EXISTS idx_agencies_owner ON agencies(owner_id);
CREATE INDEX IF NOT EXISTS idx_agency_members_agency ON agency_members(agency_id);
CREATE INDEX IF NOT EXISTS idx_agency_members_user ON agency_members(user_id);
CREATE INDEX IF NOT EXISTS idx_customers_agency ON customers(agency_id);
CREATE INDEX IF NOT EXISTS idx_customer_trips_customer ON customer_trips(customer_id);
CREATE INDEX IF NOT EXISTS idx_travel_orders_agency ON travel_orders(agency_id);
CREATE INDEX IF NOT EXISTS idx_travel_orders_customer ON travel_orders(customer_id);
CREATE INDEX IF NOT EXISTS idx_travel_orders_status ON travel_orders(status);
CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items(order_id);

-- RLS 策略
ALTER TABLE agencies ENABLE ROW LEVEL SECURITY;
ALTER TABLE agency_members ENABLE ROW LEVEL SECURITY;
ALTER TABLE customers ENABLE ROW LEVEL SECURITY;
ALTER TABLE customer_trips ENABLE ROW LEVEL SECURITY;
ALTER TABLE travel_orders ENABLE ROW LEVEL SECURITY;
ALTER TABLE order_items ENABLE ROW LEVEL SECURITY;
ALTER TABLE whitelabel_configs ENABLE ROW LEVEL SECURITY;

-- Agencies RLS
CREATE POLICY "Users can view agencies they own or are members of"
  ON agencies FOR SELECT
  USING (
    owner_id = auth.uid() OR
    id IN (SELECT agency_id FROM agency_members WHERE user_id = auth.uid())
  );

CREATE POLICY "Users can create their own agencies"
  ON agencies FOR INSERT
  WITH CHECK (owner_id = auth.uid());

CREATE POLICY "Agency owners can update their agencies"
  ON agencies FOR UPDATE
  USING (owner_id = auth.uid());

-- Customers RLS
CREATE POLICY "Agency members can view customers"
  ON customers FOR SELECT
  USING (
    agency_id IN (
      SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "Agency members can create customers"
  ON customers FOR INSERT
  WITH CHECK (
    agency_id IN (
      SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "Agency members can update customers"
  ON customers FOR UPDATE
  USING (
    agency_id IN (
      SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
    )
  );

-- Travel Orders RLS (Similar pattern for orders)
CREATE POLICY "Agency members can view orders"
  ON travel_orders FOR SELECT
  USING (
    agency_id IN (
      SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "Agency members can create orders"
  ON travel_orders FOR INSERT
  WITH CHECK (
    agency_id IN (
      SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
    )
  );

-- Order Items RLS
CREATE POLICY "Users can view order items"
  ON order_items FOR SELECT
  USING (
    order_id IN (
      SELECT id FROM travel_orders WHERE agency_id IN (
        SELECT agency_id FROM agency_members WHERE user_id = auth.uid()
      )
    )
  );

-- Whitelabel RLS
CREATE POLICY "Agency owners can manage whitelabel configs"
  ON whitelabel_configs FOR ALL
  USING (
    agency_id IN (
      SELECT id FROM agencies WHERE owner_id = auth.uid()
    )
  );


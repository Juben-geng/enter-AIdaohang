CREATE INDEX IF NOT EXISTS idx_system_config_key ON system_config(config_key);

-- RLS策略
ALTER TABLE system_config ENABLE ROW LEVEL SECURITY;

-- 所有登录用户可以读取配置
CREATE POLICY "Authenticated users can read config"
  ON system_config FOR SELECT
  TO authenticated
  USING (true);

-- 仅管理员可以修改配置
CREATE POLICY "Only admins can update config"
  ON system_config FOR UPDATE
  TO authenticated
  USING (
    EXISTS (
      SELECT 1 FROM profiles
      WHERE profiles.id = auth.uid()
      AND profiles.membership_type = 'national_agent'
    )
  )
  WITH CHECK (
    EXISTS (
      SELECT 1 FROM profiles
      WHERE profiles.id = auth.uid()
      AND profiles.membership_type = 'national_agent'
    )
  );

-- 仅管理员可以插入配置
CREATE POLICY "Only admins can insert config"
  ON system_config FOR INSERT
  TO authenticated
  WITH CHECK (
    EXISTS (
      SELECT 1 FROM profiles
      WHERE profiles.id = auth.uid()
      AND profiles.membership_type = 'national_agent'
    )
  );

-- 添加注释
COMMENT ON TABLE system_config IS '系统配置表';
COMMENT ON COLUMN system_config.config_key IS '配置键';
COMMENT ON COLUMN system_config.config_value IS '配置值';
COMMENT ON COLUMN system_config.config_type IS '配置类型: string, number, boolean, json';

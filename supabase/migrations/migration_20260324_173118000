-- 创建预设分类表
CREATE TABLE IF NOT EXISTS preset_categories (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name TEXT NOT NULL,
  icon TEXT,
  color TEXT,
  sort_order INTEGER DEFAULT 0,
  industry TEXT DEFAULT 'travel',
  description TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 创建预设链接表
CREATE TABLE IF NOT EXISTS preset_links (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  category_id UUID REFERENCES preset_categories(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  url TEXT NOT NULL,
  description TEXT,
  icon TEXT,
  link_type TEXT DEFAULT 'web',
  sort_order INTEGER DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 创建索引
CREATE INDEX IF NOT EXISTS idx_preset_categories_industry ON preset_categories(industry);
CREATE INDEX IF NOT EXISTS idx_preset_categories_sort ON preset_categories(sort_order);
CREATE INDEX IF NOT EXISTS idx_preset_links_category ON preset_links(category_id);
CREATE INDEX IF NOT EXISTS idx_preset_links_sort ON preset_links(sort_order);


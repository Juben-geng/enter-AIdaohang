
-- 删除已存在的表（如果需要）
DROP TABLE IF EXISTS articles CASCADE;
DROP TABLE IF EXISTS friend_links CASCADE;

-- 创建 Articles 表
CREATE TABLE articles (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  summary TEXT,
  content TEXT NOT NULL,
  cover_image TEXT,
  category TEXT NOT NULL,
  tags TEXT[],
  status TEXT NOT NULL DEFAULT 'draft',
  view_count INTEGER DEFAULT 0,
  is_featured BOOLEAN DEFAULT false,
  published_at TIMESTAMP WITH TIME ZONE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_articles_user_id ON articles(user_id);
CREATE INDEX idx_articles_slug ON articles(slug);
CREATE INDEX idx_articles_status ON articles(status);
CREATE INDEX idx_articles_category ON articles(category);

ALTER TABLE articles ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Anyone can view published articles" ON articles FOR SELECT USING (status = 'published');
CREATE POLICY "Authors can view own articles" ON articles FOR SELECT USING (auth.uid() = user_id);
CREATE POLICY "Admins can view all articles" ON articles FOR SELECT USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));
CREATE POLICY "Authenticated users can create articles" ON articles FOR INSERT WITH CHECK (auth.uid() = user_id);
CREATE POLICY "Authors can update own articles" ON articles FOR UPDATE USING (auth.uid() = user_id);
CREATE POLICY "Admins can update all articles" ON articles FOR UPDATE USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));
CREATE POLICY "Authors can delete own articles" ON articles FOR DELETE USING (auth.uid() = user_id);
CREATE POLICY "Admins can delete all articles" ON articles FOR DELETE USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));

-- 创建 Friend Links 表
CREATE TABLE friend_links (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  submitter_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
  name TEXT NOT NULL,
  url TEXT NOT NULL,
  description TEXT,
  logo_url TEXT,
  category TEXT,
  status TEXT NOT NULL DEFAULT 'pending',
  display_order INTEGER DEFAULT 0,
  click_count INTEGER DEFAULT 0,
  is_featured BOOLEAN DEFAULT false,
  contact_email TEXT,
  contact_name TEXT,
  admin_note TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_friend_links_submitter ON friend_links(submitter_id);
CREATE INDEX idx_friend_links_status ON friend_links(status);
CREATE INDEX idx_friend_links_display_order ON friend_links(display_order);

ALTER TABLE friend_links ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Anyone can view approved links" ON friend_links FOR SELECT USING (status = 'approved');
CREATE POLICY "Submitters can view own links" ON friend_links FOR SELECT USING (auth.uid() = submitter_id);
CREATE POLICY "Admins can view all links" ON friend_links FOR SELECT USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));
CREATE POLICY "Authenticated users can submit links" ON friend_links FOR INSERT WITH CHECK (auth.uid() = submitter_id);
CREATE POLICY "Submitters can update own pending links" ON friend_links FOR UPDATE USING (auth.uid() = submitter_id AND status = 'pending');
CREATE POLICY "Admins can update all links" ON friend_links FOR UPDATE USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));
CREATE POLICY "Submitters can delete own pending links" ON friend_links FOR DELETE USING (auth.uid() = submitter_id AND status = 'pending');
CREATE POLICY "Admins can delete all links" ON friend_links FOR DELETE USING (EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.membership_type = 'national_agent'));
